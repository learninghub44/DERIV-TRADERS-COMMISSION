# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Deriv API Configuration
# These values must match your registered Deriv OAuth application
NEXT_PUBLIC_DERIV_APP_ID=your_deriv_app_id
DERIV_CLIENT_SECRET=your_deriv_client_secret

# Deriv OAuth endpoints (do not change unless Deriv updates them)
NEXT_PUBLIC_DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
NEXT_PUBLIC_DERIV_API_BASE_URL=https://api.derivws.com

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DERIV TECH

# OAuth redirect URI - must match your registered Deriv app
NEXT_PUBLIC_DERIV_REDIRECT_URI=http://localhost:3000/api/deriv/oauth/callback

# Database
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Email (for Supabase Auth)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@yourapp.com
