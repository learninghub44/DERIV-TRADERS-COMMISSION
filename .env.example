# =============================================================================
# DERIV TECH - Environment Configuration
# =============================================================================
# This file shows ALL environment variables needed for production.
# Only the PLATFORM OWNER configures these - never expose to customers.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Direct Neon connection - server-side only, never expose to browser.
# @neondatabase/serverless talks to this over HTTP, so it works fine in
# Cloudflare Workers (edge middleware included).
DATABASE_URL=postgresql://username:password@endpoint.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# JWT secret for session management - server-side only
AUTH_SECRET=your-random-64-char-secret-here

# -----------------------------------------------------------------------------
# DERIV TECH PLATFORM CREDENTIALS (fallback only - see note below)
# -----------------------------------------------------------------------------
# These are for YOUR registered Deriv OAuth2 application (the platform
# itself, used as the "Login with Deriv" client for every customer) -
# NOT individual customer applications, and NOT the customer's own app_id
# used for markup tracking (that one is supplied by each customer at
# connect time and stored per-integration, not set here).
#
# PRIMARY CONFIG PATH: once you have a super_admin account, set these at
# /admin/settings in the running app instead - values entered there are
# stored in the platform_settings table and take priority over everything
# below. The env vars in this section only matter as a fallback for local
# dev, or before your very first admin account exists.
#
# client_id is the correct term for this value on Deriv's current API -
# register an OAuth2 app at developers.deriv.com to get one. No client
# secret is used: this flow is a public client authenticated via PKCE.
NEXT_PUBLIC_DERIV_CLIENT_ID=your_platform_deriv_client_id

# Optional: only set this if your platform ALSO has a separate app
# registered on the Legacy Deriv API (legacy-api.deriv.com). If set, it's
# appended to the login URL so Deriv can route a user who still belongs
# to the old platform to that legacy app instead of failing to log in.
# Leave unset if you only have a current-API app - most platforms do.
DERIV_LEGACY_APP_ID=

# Deriv OAuth endpoints (official - do not change, not admin-configurable)
NEXT_PUBLIC_DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
NEXT_PUBLIC_DERIV_API_BASE_URL=https://api.derivws.com

# -----------------------------------------------------------------------------
# APPLICATION URLs (fallback only - set App URL at /admin/settings instead)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=DERIV TECH
APP_URL=https://derivtech.example.com
NEXT_PUBLIC_APP_URL=https://derivtech.example.com

# Deriv OAuth redirect URI - must match your registered Deriv app.
# Set at /admin/settings once you have an admin account (see above).
NEXT_PUBLIC_DERIV_REDIRECT_URI=https://derivtech.example.com/api/deriv/oauth/callback

# -----------------------------------------------------------------------------
# EMAIL (Resend) - fallback only, set at /admin/settings instead
# -----------------------------------------------------------------------------
# Without this set anywhere (here or in /admin/settings), verification/reset
# links are logged to the server console instead of emailed, and signup
# tells the user email isn't configured yet.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=DERIV TECH <noreply@derivtech.christech.co.ke>

# -----------------------------------------------------------------------------
# ENCRYPTION (bootstrap secret - required, not admin-configurable)
# -----------------------------------------------------------------------------
# Generate a random 32-character key for AES-256 encryption. Used for
# customer Deriv credentials AND secret platform_settings values (e.g. the
# Resend API key entered at /admin/settings) - the app needs this key
# before it can decrypt anything stored in the database, so it can't be
# moved into the database itself.
ENCRYPTION_KEY=your-32-char-encryption-key-here
