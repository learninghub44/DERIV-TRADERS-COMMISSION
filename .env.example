# =============================================================================
# DERIV TECH - Environment Configuration
# =============================================================================
# This file shows ALL environment variables needed for production.
# Only the PLATFORM OWNER configures these - never expose to customers.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL via Supabase)
# -----------------------------------------------------------------------------
# Supabase connects to your Neon database
# Server-side only - never expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Neon connection for server-side operations
DATABASE_URL=postgresql://username:password@endpoint.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# JWT secret for session management - server-side only
AUTH_SECRET=your-random-64-char-secret-here

# -----------------------------------------------------------------------------
# DERIV TECH PLATFORM CREDENTIALS
# -----------------------------------------------------------------------------
# These are for YOUR registered Deriv application (the platform itself)
# Not individual customer applications
NEXT_PUBLIC_DERIV_APP_ID=your_platform_deriv_app_id
DERIV_CLIENT_SECRET=your_platform_deriv_client_secret

# Deriv OAuth endpoints (official - do not change)
NEXT_PUBLIC_DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
NEXT_PUBLIC_DERIV_API_BASE_URL=https://api.derivws.com

# -----------------------------------------------------------------------------
# APPLICATION URLs
# -----------------------------------------------------------------------------
# Production domain - update for your actual deployment
APP_URL=https://derivtech.example.com
NEXT_PUBLIC_APP_URL=https://derivtech.example.com
NEXT_PUBLIC_APP_NAME=DERIV TECH

# Deriv OAuth redirect URI - must match your registered Deriv app
NEXT_PUBLIC_DERIV_REDIRECT_URI=https://derivtech.example.com/api/deriv/oauth/callback

# -----------------------------------------------------------------------------
# EMAIL (Optional - for transactional emails)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@derivtech.example.com

# -----------------------------------------------------------------------------
# ENCRYPTION (for customer credentials at rest)
# -----------------------------------------------------------------------------
# Generate a random 32-character key for AES-256 encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here

# -----------------------------------------------------------------------------
# ADMIN ACCESS
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@yourcompany.com
